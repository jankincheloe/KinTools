{
  "name": "kintools-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "ListHandler",
    "QueryState",
    "SelectionHandler",
    "FormHandler",
    "ErrorToolkit",
    "RequestClient",
    "OverlayManager",
    "PaginationHandler",
    "PermissionEvaluator",
    "FilterBuilder",
    "SavedViews",
    "DraftHandler",
    "FileUpload",
    "DataExport",
    "CommandRegistry",
    "HistoryHandler",
    "StorageState",
    "TaskQueue"
  ],
  "scripts": {
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run validate:manifests && npm run --workspaces --if-present test && node --test scripts/integration.test.mjs"
  }
}
